{
  "theme": {
    "name": "Dark Theme",
    "base": {
      "background": {
        "primary": "#0f172a",
        "secondary": "#1e293b",
        "tertiary": "#334155",
        "hover": "#475569"
      },
      "text": {
        "primary": "#e2e8f0",
        "secondary": "#94a3b8",
        "muted": "#64748b"
      },
      "border": {
        "primary": "#334155",
        "secondary": "#475569"
      }
    },
    "brand": {
      "primary": {
        "main": "#3b82f6",
        "dark": "#2563eb",
        "light": "rgba(59, 130, 246, 0.2)",
        "gradient": "linear-gradient(135deg, rgba(59, 130, 246, 0.25) 0%, rgba(59, 130, 246, 0.35) 100%)"
      },
      "secondary": {
        "main": "#8b5cf6",
        "light": "rgba(139, 92, 246, 0.2)"
      },
      "success": {
        "main": "#10b981",
        "light": "#34d399",
        "background": "rgba(16, 185, 129, 0.2)",
        "border": "rgba(16, 185, 129, 0.3)"
      },
      "warning": {
        "main": "#f59e0b",
        "light": "#fbbf24",
        "background": "rgba(245, 158, 11, 0.2)",
        "border": "rgba(245, 158, 11, 0.3)"
      },
      "danger": {
        "main": "#ef4444",
        "background": "rgba(239, 68, 68, 0.2)",
        "border": "rgba(239, 68, 68, 0.3)"
      }
    },
    "status": {
      "online": {
        "color": "#10b981",
        "background": "rgba(16, 185, 129, 0.2)",
        "border": "rgba(16, 185, 129, 0.3)"
      },
      "offline": {
        "color": "#94a3b8",
        "background": "rgba(100, 116, 139, 0.2)",
        "border": "rgba(100, 116, 139, 0.3)"
      },
      "failed": {
        "color": "#ef4444",
        "background": "rgba(239, 68, 68, 0.2)"
      },
      "warning": {
        "color": "#f59e0b",
        "background": "rgba(245, 158, 11, 0.2)",
        "border": "rgba(245, 158, 11, 0.3)"
      },
      "saved": {
        "color": "#60a5fa",
        "background": "rgba(59, 130, 246, 0.2)",
        "border": "rgba(59, 130, 246, 0.3)"
      },
      "running": {
        "color": "#34d399",
        "background": "rgba(16, 185, 129, 0.2)",
        "border": "rgba(16, 185, 129, 0.3)"
      },
      "off": {
        "color": "#94a3b8",
        "background": "rgba(100, 116, 139, 0.2)",
        "border": "rgba(100, 116, 139, 0.3)"
      },
      "paused": {
        "color": "#fbbf24",
        "background": "rgba(245, 158, 11, 0.2)",
        "border": "rgba(245, 158, 11, 0.3)"
      }
    },
    "components": {
      "card": {
        "background": "#1e293b",
        "border": "#334155",
        "shadow": "0 2px 8px rgba(0, 0, 0, 0.3)",
        "hoverShadow": "0 4px 12px rgba(0, 0, 0, 0.4)"
      },
      "input": {
        "background": "#1e293b",
        "border": "#334155",
        "focusBorder": "#3b82f6",
        "focusShadow": "0 0 0 3px rgba(59, 130, 246, 0.1)"
      },
      "table": {
        "headerBackground": "#0f172a",
        "rowBackground": "#1e293b",
        "rowHover": "#0f172a",
        "border": "#334155"
      },
      "modal": {
        "overlay": "rgba(0, 0, 0, 0.5)",
        "background": "#0f172a",
        "headerBackground": "#1e293b",
        "shadow": "0 20px 60px rgba(0, 0, 0, 0.5)"
      },
      "button": {
        "primary": {
          "background": "linear-gradient(135deg, rgba(59, 130, 246, 0.25) 0%, rgba(59, 130, 246, 0.35) 100%)",
          "border": "rgba(59, 130, 246, 0.6)",
          "hover": "linear-gradient(135deg, rgba(59, 130, 246, 0.35) 0%, rgba(59, 130, 246, 0.45) 100%)",
          "shadow": "rgba(59, 130, 246, 0.4)"
        },
        "success": {
          "background": "linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(16, 185, 129, 0.35) 100%)",
          "border": "rgba(16, 185, 129, 0.6)",
          "hover": "linear-gradient(135deg, rgba(16, 185, 129, 0.35) 0%, rgba(16, 185, 129, 0.45) 100%)"
        },
        "danger": {
          "background": "#ef4444",
          "hover": "rgba(239, 68, 68, 0.9)"
        }
      }
    },
    "shadows": {
      "sm": "0 1px 3px 0 rgb(0 0 0 / 0.3)",
      "md": "0 2px 8px rgba(0, 0, 0, 0.3)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.4)",
      "xl": "0 20px 60px rgba(0, 0, 0, 0.5)"
    },
    "typography": {
      "fontSizes": {
        "xs": "0.625rem",
        "sm": "0.75rem",
        "base": "0.8125rem",
        "md": "0.875rem",
        "lg": "0.9375rem",
        "xl": "1rem",
        "2xl": "1.125rem",
        "3xl": "1.375rem"
      },
      "fontWeights": {
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeights": {
        "tight": 1.2,
        "normal": 1.4,
        "relaxed": 1.6
      }
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.375rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "xl": "1rem",
      "2xl": "1.25rem",
      "3xl": "1.5rem"
    },
    "borderRadius": {
      "sm": "4px",
      "md": "6px",
      "lg": "8px",
      "xl": "12px",
      "full": "999px"
    }
  }
}


